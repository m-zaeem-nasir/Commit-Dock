      <Color x:Key="Color.PopupBorder">#FF2A3832</Color>
      <Color x:Key="Color.Contents">#FF0F1512</Color>
      <Color x:Key="Color.Badge">#FF2A3832</Color>
      <Color x:Key="Color.BadgeFG">#FFE3EFE9</Color>
      <Color x:Key="Color.Border0">#FF090D0B</Color>
      <Color x:Key="Color.Border1">#FF627A6F</Color>
      <Color x:Key="Color.Border2">#FF24302B</Color>
      <Color x:Key="Color.FlatButton.Background">#FF1C2722</Color>
