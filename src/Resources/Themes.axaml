      <Color x:Key="Color.BadgeFG">#FFF3E9E2</Color>
      <Color x:Key="Color.Border0">#FF0E0B0A</Color>
      <Color x:Key="Color.Border1">#FF85715F</Color>
      <Color x:Key="Color.Border2">#FF322823</Color>
