      <Color x:Key="Color.ToolBar">#FF201F2D</Color>
      <Color x:Key="Color.Popup">#FF242336</Color>
      <Color x:Key="Color.PopupBorder">#FF35324D</Color>
      <Color x:Key="Color.Contents">#FF15141D</Color>
      <Color x:Key="Color.Badge">#FF3B3858</Color>
      <Color x:Key="Color.BadgeFG">#FFE8E6F7</Color>
      <Color x:Key="Color.Conflict">#FFFFE3A3</Color>
      <Color x:Key="Color.Conflict.Foreground">#FF1B1A26</Color>
      <Color x:Key="Color.Conflict.MineBG">#405AA9FF</Color>
      <Color x:Key="Color.Conflict.TheirsBG">#40FF8A6B</Color>
      <Color x:Key="Color.Border0">#FF0F0E16</Color>
      <Color x:Key="Color.Border1">#FF6E6A8E</Color>
      <Color x:Key="Color.Border2">#FF302E44</Color>
      <Color x:Key="Color.FlatButton.Background">#FF262539</Color>
      <Color x:Key="Color.FlatButton.BackgroundHovered">#FF2F2D46</Color>
      <Color x:Key="Color.FlatButton.FloatingBorder">#FF423F5E</Color>
      <Color x:Key="Color.FG1">#FFE6E4F2</Color>
      <Color x:Key="Color.FG2">#FF9C98B8</Color>
      <Color x:Key="Color.Diff.EmptyBG">#3C000000</Color>
      <Color x:Key="Color.Diff.AddedBG">#C0244A3A</Color>
      <Color x:Key="Color.Diff.DeletedBG">#C0532E3C</Color>
      <Color x:Key="Color.Diff.AddedHighlight">#A02E8F62</Color>
      <Color x:Key="Color.Diff.DeletedHighlight">#A0A23B5A</Color>
      <Color x:Key="Color.Diff.BlockBorderHighlight">#FF3DD6E0</Color>
      <Color x:Key="Color.Link">#FF8DB8FF</Color>
      <Color x:Key="Color.InlineCode">#FF2C2A40</Color>
      <Color x:Key="Color.InlineCodeFG">#FFF0EEFA</Color>
      <Color x:Key="Color.SubPanel">#FF1E1D2A</Color>
    </ResourceDictionary>

    <!-- Obsidian: neutral graphite with a teal accent. Anything not set here falls back to Dark. -->
