      <Color x:Key="Color.FlatButton.Background">#FF18243A</Color>
      <Color x:Key="Color.FlatButton.BackgroundHovered">#FF1F2D47</Color>
      <Color x:Key="Color.FlatButton.FloatingBorder">#FF2E4060</Color>
      <Color x:Key="Color.FG1">#FFE1E9F5</Color>
