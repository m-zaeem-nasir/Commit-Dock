      <Color x:Key="SystemAccentColor">#FF34D399</Color>
      <Color x:Key="Color.Window">#FF131A17</Color>
      <Color x:Key="Color.WindowBorder">#FF2E3D36</Color>
      <Color x:Key="Color.TitleBar">#FF0E1411</Color>
      <Color x:Key="Color.ToolBar">#FF17201C</Color>
