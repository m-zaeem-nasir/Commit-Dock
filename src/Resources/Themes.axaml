      <Color x:Key="Color.Window">#FF1B1C1F</Color>
      <Color x:Key="Color.WindowBorder">#FF3A3C42</Color>
      <Color x:Key="Color.TitleBar">#FF141518</Color>
      <Color x:Key="Color.ToolBar">#FF202125</Color>
      <Color x:Key="Color.Popup">#FF25272B</Color>
      <Color x:Key="Color.PopupBorder">#FF36383E</Color>
      <Color x:Key="Color.Contents">#FF151619</Color>
      <Color x:Key="Color.Badge">#FF3A3C42</Color>
      <Color x:Key="Color.BadgeFG">#FFE8E9EC</Color>
      <Color x:Key="Color.Border0">#FF0D0E10</Color>
      <Color x:Key="Color.Border1">#FF6B6E76</Color>
      <Color x:Key="Color.Border2">#FF2E3035</Color>
      <Color x:Key="Color.FlatButton.Background">#FF26282C</Color>
      <Color x:Key="Color.FlatButton.BackgroundHovered">#FF2E3035</Color>
      <Color x:Key="Color.FlatButton.FloatingBorder">#FF40434A</Color>
      <Color x:Key="Color.FG1">#FFE6E7EA</Color>
      <Color x:Key="Color.FG2">#FF9A9DA6</Color>
      <Color x:Key="Color.Link">#FF5EEAD4</Color>
      <Color x:Key="Color.InlineCode">#FF2A2C31</Color>
      <Color x:Key="Color.InlineCodeFG">#FFF0F1F3</Color>
      <Color x:Key="Color.SubPanel">#FF1E1F23</Color>
    </ResourceDictionary>

