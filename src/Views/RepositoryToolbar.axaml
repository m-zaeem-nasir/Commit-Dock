<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:CommitDock.Models"
             xmlns:vm="using:CommitDock.ViewModels"
             xmlns:c="using:CommitDock.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CommitDock.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Styles>
    <Style Selector="Border.sync_badge">
      <Setter Property="Height" Value="14"/>
      <Setter Property="MinWidth" Value="14"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Margin" Value="0,-5,-9,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Border.sync_badge > TextBlock">
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
    </Style>
    <Style Selector="Button.branch_chip">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Contents}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.branch_chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <!-- Narrow windows: drop the text labels and tighten the buttons. -->
    <ContainerQuery Name="RepoToolbar" Query="max-width:1080">
      <Style Selector="TextBlock.tool_label">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="StackPanel.tool_label_row">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="Button.tool">
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="6,0"/>
      </Style>
      <Style Selector="Border.current_branch">
        <Setter Property="MaxWidth" Value="160"/>
      </Style>
    </ContainerQuery>

    <!-- Very narrow windows: keep only the core git actions. -->
    <ContainerQuery Name="RepoToolbar" Query="max-width:820">
      <Style Selector="StackPanel.toolbar_left">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="Border.current_branch">
        <Setter Property="MaxWidth" Value="90"/>
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto,0,*" Container.Name="RepoToolbar" Container.Sizing="Width">
    <StackPanel Grid.Column="0" Classes="toolbar_left" Orientation="Horizontal" Margin="6,0,0,0">
      <Button Classes="tool" Click="OpenWithExternalTools" ToolTip.Tip="{DynamicResource Text.Repository.OpenWithExternalTools}">
        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.OpenWith}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Toolbar.Open}"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
      <Button Classes="tool" Tapped="Fetch">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Fetch}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.Fetch}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Fetch}"/>
        </StackPanel>
      </Button>

      <StackPanel Orientation="Horizontal" IsVisible="{Binding !IsBare}">
        <Button Classes="tool" Tapped="Pull" IsEnabled="{Binding !IsBare}">
          <ToolTip.Tip>
            <StackPanel Orientation="Vertical">
              <TextBlock Text="{DynamicResource Text.Pull}"/>
              <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
          </ToolTip.Tip>

          <StackPanel>
            <Grid Width="22" Height="15" HorizontalAlignment="Center">
              <Path Width="15" Height="15" Data="{StaticResource Icons.Pull}"/>
<Border Classes="sync_badge" IsVisible="{Binding CurrentBranch?.Behind, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding CurrentBranch?.Behind, Mode=OneWay, Converter={x:Static c:ListConverters.ToCountNumber}}"/>
            </Border>
            </Grid>
            <TextBlock Classes="tool_label" Text="{DynamicResource Text.Pull}"/>
          </StackPanel>
        </Button>

        <Button Classes="tool arrow" Click="OpenPullOptions" ToolTip.Tip="{DynamicResource Text.Toolbar.PullOptions}">
          <Path Width="9" Height="9" VerticalAlignment="Top" Margin="0,8,0,0" Data="{StaticResource Icons.Down}"/>
        </Button>
      </StackPanel>

      <Button Classes="tool" Tapped="Push">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Push}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel>
          <Grid Width="22" Height="15" HorizontalAlignment="Center">
            <Path Width="15" Height="15" Data="{StaticResource Icons.Push}"/>
<Border Classes="sync_badge" IsVisible="{Binding CurrentBranch?.Ahead, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding CurrentBranch?.Ahead, Mode=OneWay, Converter={x:Static c:ListConverters.ToCountNumber}}"/>
            </Border>
          </Grid>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Push}"/>
        </StackPanel>
      </Button>

      <Rectangle Width="1" Height="28" Margin="8,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Border2}"/>

      <Button Classes="tool" Command="{Binding CreateNewBranch}" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Repository.NewBranch}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+B, macOS=⌘+B}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>

        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.Branch.Add}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Toolbar.Branch}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Tapped="StashAll" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Stash}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.Stashes.Add}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Stash}"/>
        </StackPanel>
      </Button>

      <Rectangle Width="1" Height="28" Margin="8,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Border2}"/>

      <Button Classes="tool" Click="OpenTerminal" ToolTip.Tip="{DynamicResource Text.Repository.Terminal}">
        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.Terminal}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Toolbar.Terminal}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Click="OpenToolsMenu" ToolTip.Tip="{DynamicResource Text.Toolbar.ToolsTip}">
        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.Tool}"/>
          <StackPanel Classes="tool_label_row" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
            <TextBlock Classes="tool_label" Margin="0" Text="{DynamicResource Text.Toolbar.Tools}"/>
            <Path Width="7" Height="7" Margin="4,1,0,0" Data="{StaticResource Icons.Down}" Fill="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>

    <Grid Grid.Column="3" HorizontalAlignment="Right" ColumnDefinitions="*,Auto" Margin="18,0,8,0">
      <Button Grid.Column="0"
              Classes="branch_chip"
              Click="OpenBranchSwitcher"
              ToolTip.Tip="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0" Width="13" Height="13" Data="{StaticResource Icons.Branch}" Fill="{DynamicResource Brush.Accent}"/>
          <Border Grid.Column="1" Classes="current_branch" Margin="8,0" MaxWidth="260">
            <TextBlock Text="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
          </Border>
          <Path Grid.Column="2" Width="9" Height="9" Data="{StaticResource Icons.Down}" Fill="{DynamicResource Brush.FG2}"/>
        </Grid>
      </Button>

      <Button Grid.Column="1"
              Classes="icon_button"
              Width="32" Height="32"
              Margin="4,0,0,0"
              Click="NavigateToHead"
              ToolTip.Tip="{DynamicResource Text.Repository.NavigateToCurrentHead}">
        <Path Width="14" Height="14"
              Data="{StaticResource Icons.Target}"/>
      </Button>
    </Grid>
  </Grid>
</UserControl>
