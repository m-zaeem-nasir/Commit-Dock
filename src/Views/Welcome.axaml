<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:CommitDock.Converters"
             xmlns:m="using:CommitDock.Models"
             xmlns:vm="using:CommitDock.ViewModels"
             xmlns:v="using:CommitDock.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CommitDock.Views.Welcome"
             x:DataType="vm:Welcome">
  <Grid RowDefinitions="*,Auto" Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*"/>
      <ColumnDefinition Width="2*" MinWidth="600" MaxWidth="980"/>
      <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>

    <!-- Managed Repositories -->
    <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="0,24,0,0">
      <!-- Hero: what this screen is for, and the two ways to get a repository in -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Text.Welcome.Empty.Title}" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource Text.Welcome.Empty.Desc}" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Classes="flat" Height="34" Padding="14,0" Command="{Binding OpenLocalRepository}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Width="14" Height="14" Data="{StaticResource Icons.Folder.Open}"/>
              <TextBlock Text="{DynamicResource Text.Toolbar.Open}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="flat primary" Height="34" Padding="14,0" Command="{Binding Clone}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Width="14" Height="14" Data="{StaticResource Icons.Clone}"/>
              <TextBlock Text="{DynamicResource Text.Toolbar.Clone}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OnAccent}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Search Box -->
      <TextBox Grid.Row="1"
               x:Name="SearchBox"
               Height="38"
               Padding="0"
               CornerRadius="{DynamicResource Radius.Large}"
               BorderThickness="1"
               Background="{DynamicResource Brush.Contents}"
               Watermark="{DynamicResource Text.Welcome.Search}"
               VerticalContentAlignment="Center"
               Text="{Binding SearchFilter, Mode=TwoWay}">
        <TextBox.InnerLeftContent>
          <Path Width="15" Height="15" Margin="12,0,6,0" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
        </TextBox.InnerLeftContent>

        <TextBox.InnerRightContent>
          <StackPanel Orientation="Horizontal">
            <!-- Invisible Button to handle search hotkey pressed-->
            <Button Width="0" Height="0"
                    Margin="0" Padding="0"
                    Click="OnSearchHotKey"
                    HotKey="{OnPlatform Ctrl+F, macOS=⌘+F}"/>

            <Button Classes="icon_button" IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Click="OnClearSearchFilter">
              <Path Width="15" Height="15" Margin="0,0,8,0" Data="{StaticResource Icons.Clear}" Fill="{DynamicResource Brush.FG2}"/>
            </Button>
          </StackPanel>
        </TextBox.InnerRightContent>
      </TextBox>

      <!-- Repository Tree -->
      <v:RepositoryListBox Grid.Row="2"
                           x:Name="TreeContainer"
                           Margin="0,10,0,0"
                           Focusable="True"
                           Background="Transparent"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ItemsSource="{Binding Rows}"
                           SelectionMode="Single"
                           LostFocus="OnTreeViewLostFocus"
                           DragDrop.AllowDrop="True"
                           DragDrop.DragOver="DragOverTreeView"
                           DragDrop.Drop="DropOnTreeView">
        <ListBox.Styles>
          <Style Selector="ListBox">
            <Setter Property="FocusAdorner">
              <FocusAdornerTemplate>
                <Border Background="Transparent" BorderThickness="0"/>
              </FocusAdornerTemplate>
            </Setter>
          </Style>

          <Style Selector="ListBoxItem" x:DataType="vm:RepositoryNode">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}"/>
            <Setter Property="FocusAdorner">
              <FocusAdornerTemplate>
                <Border Background="Transparent" BorderThickness="0"/>
              </FocusAdornerTemplate>
            </Setter>
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
          </Style>
        </ListBox.Styles>

        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{DynamicResource Text.Welcome.AddRootFolder}" Command="{Binding AddRootNode}">
              <MenuItem.Icon>
                <Path Width="12" Height="12" Data="{DynamicResource Icons.Folder.Add}"/>
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </ListBox.ContextMenu>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:RepositoryNode">
            <Grid Background="Transparent"
                  Height="36"
                  ColumnDefinitions="20,22,*,Auto,10"
                  Margin="{Binding Depth, Converter={x:Static c:IntConverters.ToTreeMargin}}"
                  ClipToBounds="True"
                  ContextRequested="OnTreeNodeContextRequested"
                  PointerPressed="OnPointerPressedTreeNode"
                  PointerMoved="OnPointerMovedOverTreeNode"
                  PointerReleased="OnPointerReleasedOnTreeNode"
                  DoubleTapped="OnDoubleTappedTreeNode"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragOver="DragOverTreeNode"
                  DragDrop.Drop="DropOnTreeNode">
              <v:RepositoryTreeNodeToggleButton Grid.Column="0"
                                                Classes="tree_expander"
                                                Focusable="False"
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                                IsVisible="{Binding !IsRepository}"/>

              <v:Bookmark Grid.Column="1"
                          Width="14" Height="14"
                          HorizontalAlignment="Center"
                          Value="{Binding Bookmark, Mode=OneWay}"
                          IsVisible="{Binding IsRepository}"/>

              <ToggleButton Grid.Column="1"
                            Classes="folder"
                            Focusable="False"
                            Width="14" Height="14"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource Brush.FG1}"
                            IsChecked="{Binding IsExpanded}"
                            IsVisible="{Binding !IsRepository}"/>

              <StackPanel Grid.Column="2" Orientation="Horizontal" ClipToBounds="True">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}"/>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Id, Converter={x:Static c:PathConverters.RelativeToHome}}">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="IsRepository"/>
                      <Binding Path="IsInvalid" Converter="{x:Static BoolConverters.Not}"/>
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>
                <Path Margin="2,0,0,0"
                      Width="12" Height="12"
                      Data="{StaticResource Icons.Error}"
                      Fill="{DynamicResource Brush.Warning}"
                      IsVisible="{Binding IsInvalid}"/>
              </StackPanel>

              <ContentControl Grid.Column="3"
                              Margin="6,0,0,0"
                              Content="{Binding Status, Mode=OneWay}"
                              IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="m:RepositoryStatus">
                    <StackPanel Orientation="Horizontal">
                      <Border Margin="4,0"
                              Height="20"
                              CornerRadius="10"
                              Padding="7,0"
                              Background="{DynamicResource Brush.Hover}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{DynamicResource Text.WorkingCopy}"
                              IsVisible="{Binding LocalChanges, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Modified}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding LocalChanges}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                      </Border>

                      <TextBlock Margin="4,0"
                                 Text="{Binding TrackingDescription}"
                                 FontSize="12"
                                 Foreground="{DynamicResource Brush.FG2}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsTrackingStatusVisible}"/>

                      <Border Margin="4,0,0,0"
                              Height="22"
                              CornerRadius="11"
                              Padding="8,0"
                              Background="{DynamicResource Brush.Hover}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                          <Path Width="11" Height="11" Data="{StaticResource Icons.Branch}" Fill="{DynamicResource Brush.Accent}"/>
                          <TextBlock Text="{Binding CurrentBranch}" FontSize="12"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </v:RepositoryListBox>
    </Grid>

    <!-- Tips -->
    <Border Grid.Row="1" Grid.Column="1"
            Margin="0,8,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            IsVisible="{OnPlatform True, Linux=False}">
      <TextBlock FontSize="12"
                 Text="{DynamicResource Text.Welcome.DragDropTip}"
                 Foreground="{DynamicResource Brush.FG2}"/>
    </Border>
  </Grid>
</UserControl>
