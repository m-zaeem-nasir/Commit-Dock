<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CommitDock.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CommitDock.Views.WelcomeToolbar"
             x:DataType="vm:Welcome">
  <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,0">
    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
      <Button Classes="tool" Command="{Binding Clone}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.Clone}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+R, macOS=⌘+R}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.Clone}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Toolbar.Clone}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Command="{Binding OpenLocalRepository}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.OpenOrInit}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+L, macOS=⌘+L}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.Folder.Open}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Toolbar.Open}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Command="{Binding OpenTerminal}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Welcome.OpenTerminal}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+`, macOS=Λ+`}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.Terminal}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Toolbar.Terminal}"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
      <Button Classes="tool" Command="{Binding AddRootNode}" ToolTip.Tip="{DynamicResource Text.Welcome.AddRootFolder}">
        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.Folder.Add}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Toolbar.AddFolder}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Command="{Binding ScanDefaultCloneDir}" ToolTip.Tip="{DynamicResource Text.Welcome.ScanDefaultCloneDir}">
        <StackPanel>
          <Path Width="15" Height="15" Data="{StaticResource Icons.Scan}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Toolbar.Scan}"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
